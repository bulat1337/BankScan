{
  "name": "bankscan",
  "version": "0.1.0",
  "description": "Local bridge for extracting Alfa-Bank and VTB balances from authenticated web sessions via Chrome DevTools Protocol.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "alfabank",
    "vtb",
    "banking",
    "chrome-devtools-protocol",
    "local-automation"
  ],
  "scripts": {
    "open": "node scripts/bank-balance-bridge.mjs open all",
    "scan": "node scripts/bank-balance-bridge.mjs scan all",
    "scan:reload": "node scripts/bank-balance-bridge.mjs scan all --reload",
    "sync": "node scripts/bank-balance-bridge.mjs sync all",
    "sync:alpha": "node scripts/bank-balance-bridge.mjs sync alpha",
    "sync:vtb": "node scripts/bank-balance-bridge.mjs sync vtb",
    "help": "node scripts/bank-balance-bridge.mjs help"
  }
}
